              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/User" },
                    "meta": { "type": "object", "properties": { "requestId": { "type": "string" } } },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "summary": "Update User",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
