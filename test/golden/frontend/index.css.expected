@tailwind base;
@tailwind components;
@tailwind utilities;

/* Markdown prose styling */
.prose { color: #0f172a; }
.dark .prose { color: #e2e8f0; }
.prose p { margin: 0.75rem 0; line-height: 1.75; }
.prose h1, .prose h2, .prose h3, .prose h4 { font-weight: 700; color: inherit; margin: 1.25rem 0 0.5rem; }
.prose h1 { font-size: 2rem; }
.prose h2 { font-size: 1.5rem; }
.prose h3 { font-size: 1.25rem; }
.prose a { color: #2563eb; text-decoration: underline; text-underline-offset: 3px; }
.dark .prose a { color: #93c5fd; }
.prose ul, .prose ol { margin: 0.75rem 0 0.75rem 1.25rem; }
.prose li { margin: 0.25rem 0; }
.prose code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; background: rgba(15, 23, 42, 0.08); padding: 0.1rem 0.35rem; border-radius: 0.375rem; font-size: 0.85em; }
.dark .prose code { background: rgba(148, 163, 184, 0.2); }
.prose pre { background: #0f172a; color: #e2e8f0; padding: 1rem 1.25rem; border-radius: 0.75rem; overflow-x: auto; overflow-y: hidden; font-size: 0.85rem; line-height: 1.6; }
.prose pre code { background: transparent; padding: 0; color: inherit; }
